.env

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Large binary/generated assets -- not practical or useful to version in
# git (17GB+ of extracted catalog images/PDFs, 1.4GB of source PDFs, a
# 56MB poppler binary distribution). These are reproducible from
# Price_list/ + extract_catalog.py, or are the raw source PDFs themselves
# -- not code, and not something a diff-based history helps with.
data/
Price_list/
poppler-26.02.0/

# Regression suite output -- regenerated by every `npm run regression`
# (or stress-v2) run, not meaningful history on its own (the queries.json
# fixtures and run.ts/stress_v2.ts logic are the actual versioned source).
App/regression/last-run.json
App/regression/stress_v2-run.json
App/regression/check_multi_product_isolation-run.json

*.log

# Local tool config/caches -- not project source
.claude/
**/__pycache__/
*.pyc
venv/
.DS_Store
.ipynb_checkpoints/
build/
